# =============================================================================
# Spectra Docker Compose — Environment Configuration
#
# Copy to .env and adjust:
#   cp docker/.env.example docker/.env
#
# Then edit values and run:
#   docker compose up spectra-backend
#   docker compose run --rm spectra-app
# =============================================================================

# ─── ROS2 DDS ────────────────────────────────────────────────────────────────
# All containers must share the same domain ID for DDS discovery.
# Use different IDs to isolate multiple Spectra instances on the same network.
ROS_DOMAIN_ID=42

# ─── Display (X11 forwarding) ────────────────────────────────────────────────
# Linux:   DISPLAY=:0  (run `xhost +local:docker` on host first)
# macOS:   DISPLAY=host.docker.internal:0  (use XQuartz)
# Windows: DISPLAY=host.docker.internal:0  (use VcXsrv)
DISPLAY=:0

# X11 auth cookie — mount into container so X server accepts connections
# On most Linux systems this is ~/.Xauthority
# If xhost +local:docker is used, this may not be needed but is recommended
XAUTHORITY=/home/daniel/.Xauthority

# ─── Wayland (optional) ──────────────────────────────────────────────────────
# If your host uses Wayland, set these to enable native Wayland forwarding:
# WAYLAND_DISPLAY=wayland-0
# WAYLAND_SOCKET_DIR=/run/user/1000
# XDG_SESSION_TYPE=wayland

# ─── GPU passthrough (optional) ──────────────────────────────────────────────
# Uncomment for hardware Vulkan rendering instead of lavapipe software:
#
# DRI_DEVICE=/dev/dri
# VK_ICD_FILENAMES=/host-vulkan-icd/radeon_icd.x86_64.json
# VK_DRIVER_FILES=/host-vulkan-icd/radeon_icd.x86_64.json
# VULKAN_ICD_DIR=/usr/share/vulkan/icd.d
#
# Intel:   radeon_icd → intel_icd.x86_64.json
# AMD:     radeon_icd.x86_64.json
# NVIDIA:  nvidia_icd.json (requires nvidia-container-toolkit)

# ─── ROS2 bag replay path ────────────────────────────────────────────────────
# Path inside the container (mounted from spectra-data volume)
# BAG_PATH=/data/bags/my_recording
